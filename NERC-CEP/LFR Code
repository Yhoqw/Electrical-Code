/*
 * PROJECT: NERC/CEP 2026 Autonomous Robot
 * VERSION: 3.8 (No-Centre Alternating Correction)
 * AUTHOR: Yazdan Ali Khan (2024665)
 * TARGET: PIC18F4550 @ 8MHz
 *
 * LINE FOLLOW PHILOSOPHY (this version):
 *   S3 (centre) is IGNORED for steering decisions.
 *   The robot reads only S1/S2 (left) and S4/S5 (right).
 *   If the line is more on the left  → steer LEFT
 *   If the line is more on the right → steer RIGHT
 *   If perfectly ambiguous           → use last_error to decide
 *   This creates a constant oscillating micro-correction that
 *   tracks tight curves more aggressively than centre-biased logic.
 */

#pragma config FOSC   = INTOSC_HS
#pragma config PLLDIV = 1
#pragma config CPUDIV = OSC1_PLL2
#pragma config USBDIV = 1
#pragma config FCMEN  = OFF
#pragma config IESO   = OFF
#pragma config PWRT   = OFF
#pragma config BOR    = OFF
#pragma config VREGEN = OFF
#pragma config WDT    = OFF
#pragma config WDTPS  = 32768
#pragma config CCP2MX = ON
#pragma config PBADEN = OFF
#pragma config LPT1OSC= OFF
#pragma config MCLRE  = ON
#pragma config STVREN = OFF
#pragma config LVP    = OFF
#pragma config ICPRT  = OFF
#pragma config XINST  = OFF

#include <xc.h>
#include <stdint.h>

#define _XTAL_FREQ 8000000

// ============================================================
//  PIN ARCHITECTURE
// ============================================================

#define LED_SYS_OK      LATDbits.LATD0
#define LED_BUSY        LATDbits.LATD1
#define LED_ERROR       LATDbits.LATD2

#define MOTOR_LEFT_F    LATDbits.LATD4
#define MOTOR_LEFT_B    LATDbits.LATD5
#define MOTOR_RIGHT_F   LATDbits.LATD6
#define MOTOR_RIGHT_B   LATDbits.LATD7

#define SERVO_PWM       LATBbits.LATB3

#define COLOR_S2        LATBbits.LATB4
#define COLOR_S3        LATBbits.LATB1
#define COLOR_IN        PORTBbits.RB2

#define SENSORS_PORT    PORTA
#define S_FAR_LEFT      PORTAbits.RA0   // S1
#define S_LEFT          PORTAbits.RA1   // S2
#define S_CENTER        PORTAbits.RA2   // S3 — not used for steering
#define S_RIGHT         PORTAbits.RA3   // S4
#define S_FAR_RIGHT     PORTAbits.RA5   // S5

#define SONAR_TRIG      LATCbits.LATC0
#define SONAR_ECHO      PORTBbits.RB5

// ============================================================
//  SPEED SETTING
// ============================================================
#define MOTOR_SPEED     128
#define FAST_SPEED    120
#define SLOW_SPEED    95
#define TURN_SPEED    140

// ============================================================
//  GLOBAL STATE
// ============================================================
volatile uint8_t robot_mode          = 2;
volatile int     node_count          = 0;
volatile int     last_node           = -1;
volatile uint8_t junction_lock       = 0;
volatile uint8_t junction_count      = 0;
volatile int     case1_change_counter = 0;
volatile int8_t  last_error          = 0;  // -1 = last turned left, +1 = last turned right

float Version        = 3.9;
int   Sonar_Distance = 5;

// ============================================================
//  PWM INIT
// ============================================================
void pwm_init(void) {
    TRISCbits.TRISC2 = 0;
    TRISCbits.TRISC1 = 0;
    PR2     = 199;
    CCP1CON = 0x0C;
    CCP2CON = 0x0C;
    CCPR1L  = MOTOR_SPEED;
    CCPR2L  = MOTOR_SPEED;
    T2CON   = 0x05;
}

// ============================================================
//  SERVO
// ============================================================
static void _servo_pulse(uint16_t us) {
    SERVO_PWM = 1;
    while (us--) { __delay_us(1); }
    SERVO_PWM = 0;
}

void set_servo_angle(uint8_t angle) {
    uint8_t i;
    uint16_t pulse_us = 1000u + ((uint16_t)angle * 1000u / 180u);
    for (i = 0; i < 40; i++) {
        _servo_pulse(pulse_us);
        __delay_ms(20);
    }
}

// ============================================================
//  MOTOR CONTROL
// ============================================================
void set_speed(uint8_t left, uint8_t right) {
    CCPR2L = left;
    CCPR1L = right;
}

void drive(int8_t left, int8_t right) {
    MOTOR_LEFT_F  = (left  > 0);
    MOTOR_LEFT_B  = (left  < 0);
    MOTOR_RIGHT_F = (right > 0);
    MOTOR_RIGHT_B = (right < 0);
}

static void forward(void) {
    set_speed(FAST_SPEED, FAST_SPEED);
    drive(1, 1);
}

static void soft_left(void) {
    set_speed(SLOW_SPEED, FAST_SPEED);
    drive(1, 1);
}

static void soft_right(void) {
    set_speed(FAST_SPEED, SLOW_SPEED);
    drive(1, 1);
}

static void hard_left(void) {
    set_speed(TURN_SPEED, TURN_SPEED);
    drive(-1, 1);
}

static void hard_right(void) {
    set_speed(TURN_SPEED, TURN_SPEED);
    drive(1, -1);
}

static void stop(void)       { set_speed(0, 0); drive( 0,  0); }


void motor_init_safe(void) {
    MOTOR_LEFT_F  = 0; MOTOR_LEFT_B  = 0;
    MOTOR_RIGHT_F = 0; MOTOR_RIGHT_B = 0;
    CCPR1L = 0; CCPR2L = 0;
    __delay_ms(50);
}

void line_follow(void) {

    uint8_t s1 = !S_FAR_LEFT;
    uint8_t s2 = !S_LEFT;
    uint8_t s3 = !S_CENTER;
    uint8_t s4 = !S_RIGHT;
    uint8_t s5 = !S_FAR_RIGHT;

    // ========================================================
    // FULL LINE LOSS RECOVERY
    // ========================================================

    if (!s1 && !s2 && !s3 && !s4 && !s5) {

        if (last_error <= 0) {

            while (1) {

                hard_left();

                if (!S_FAR_LEFT || !S_LEFT ||
                    !S_CENTER   || !S_RIGHT ||
                    !S_FAR_RIGHT) {

                    last_error = -1;
                    return;
                }
            }

        } else {

            while (1) {

                hard_right();

                if (!S_FAR_LEFT || !S_LEFT ||
                    !S_CENTER   || !S_RIGHT ||
                    !S_FAR_RIGHT) {

                    last_error = 1;
                    return;
                }
            }
        }
    }

    // ========================================================
    // SHARP CORNER RECOVERY
    // ========================================================

    if (s1 && !s5) {

        hard_left();
        __delay_ms(2);

        last_error = -1;
        return;
    }

    if (s5 && !s1) {

        hard_right();
        __delay_ms(2);

        last_error = 1;
        return;
    }

    // ========================================================
    // PRIMARY TRACKING
    // S2 and S4 dominate behavior
    // ========================================================

    if (s2 && !s4) {

        soft_left();
        __delay_ms(1);

        last_error = -1;
    }

    else if (s4 && !s2) {

        soft_right();
        __delay_ms(1);

        last_error = 1;
    }

    // ========================================================
    // CENTERED / AMBIGUOUS
    // ========================================================

    else {

        // Tiny oscillation only

        if (last_error <= 0) {

            soft_left();
            __delay_ms(1);

        } else {

            soft_right();
            __delay_ms(1);
        }
    }
}


// ============================================================
//  JUNCTION DETECTION  (uses all 5 sensors including S3)
// ============================================================
uint8_t detect_junction(void) {
    if (!S_FAR_LEFT && !S_LEFT && !S_CENTER && !S_RIGHT && !S_FAR_RIGHT) {
        __delay_ms(70);
        if (!S_FAR_LEFT && !S_LEFT && !S_CENTER && !S_RIGHT && !S_FAR_RIGHT)
            return 1;
    }
    return 0;
}

// ============================================================
//  COLOUR DETECTION
// ============================================================
uint8_t is_blue_slot(void) {
    COLOR_S2 = 0;
    COLOR_S3 = 1;
    __delay_ms(15);
    return COLOR_IN;
}

// ============================================================
//  PALLET DEPLOYMENT
// ============================================================
void demo_placement(void) {
    stop();
    __delay_ms(200);

    if (is_blue_slot()) {
        set_servo_angle(90);
        LED_SYS_OK = 1; LED_BUSY = 0;
    } else {
        set_servo_angle(45);
        LED_SYS_OK = 0; LED_BUSY = 1;
    }

    __delay_ms(400);
    set_servo_angle(0);
    __delay_ms(300);

    LED_SYS_OK = 0; LED_BUSY = 0;
}

// ============================================================
//  TURN HELPERS
// ============================================================
void turn_right(void) {
    hard_right();
    while (S_CENTER) { }
    stop();
}

void turn_left(void) {
    hard_left();
    while (S_CENTER) { }
    stop();
}

// ============================================================
//  SONAR
// ============================================================
uint16_t sonar_read_cm(void) {
    uint16_t time = 0;
    uint16_t timeout;

    SONAR_TRIG = 0; __delay_us(2);
    SONAR_TRIG = 1; __delay_us(10);
    SONAR_TRIG = 0;

    timeout = 30000;
    while (!SONAR_ECHO && timeout--) __delay_us(1);
    if (timeout == 0) return 0;

    while (SONAR_ECHO) {
        time++;
        __delay_us(1);
        if (time > 30000) break;
    }
    return time / 58;
}

// ============================================================
//  POWER-ON SELF TEST
// ============================================================
void run_power_on_self_test(void) {
    LED_SYS_OK = 1; __delay_ms(300);
    LED_BUSY   = 1; __delay_ms(200);
    LED_ERROR  = 1; __delay_ms(200);
    LATD &= 0b00000111;

    set_servo_angle(0);  __delay_ms(300);
    set_servo_angle(90); __delay_ms(300);
    set_servo_angle(0);

    if (SENSORS_PORT == 0xFF) { LED_ERROR = 1; }
}

// ============================================================
//  ISR
// ============================================================
void __interrupt() ISR(void) {
    if (INT0IF) {
        __delay_ms(20);
        if (PORTBbits.RB0 == 0) {
            robot_mode = (robot_mode + 1) % 3;
            node_count = 0;
            last_node  = -1;
            stop();
        }
        INT0IF = 0;
    }
}

// ============================================================
//  MAIN
// ============================================================
void main(void) {
    OSCCON = 0x72;
    ADCON1 = 0x0F;

    TRISA = 0xFF;

    TRISBbits.TRISB0 = 1;
    TRISBbits.TRISB1 = 0;
    TRISBbits.TRISB2 = 1;
    TRISBbits.TRISB3 = 0;
    TRISBbits.TRISB4 = 0;
    TRISBbits.TRISB5 = 1;

    TRISCbits.TRISC0 = 0;
    TRISCbits.TRISC1 = 0;
    TRISCbits.TRISC2 = 0;

    TRISD = 0x00;

    motor_init_safe();

    set_servo_angle(0);  __delay_ms(300);
    set_servo_angle(90); __delay_ms(300);
    set_servo_angle(0);

    pwm_init();

    INTCONbits.GIE    = 0;
    INTCONbits.INT0IE = 0;

    while (1) {
        switch (robot_mode) {

            // ------------------------------------------------
            case 0: // STANDBY
            // ------------------------------------------------
                LED_SYS_OK = 1; LED_BUSY = 0; LED_ERROR = 0;
                case1_change_counter += 1;
                {
                    static uint16_t blinkTimer = 0;
                    if (!S_CENTER) {
                        if (blinkTimer >= 200) {
                            LED_BUSY = !LED_BUSY;
                            blinkTimer = 0;
                        }
                        __delay_ms(1);
                        blinkTimer++;
                    } else {
                        LED_BUSY = 0;
                        blinkTimer = 0;
                    }
                }
                if (case1_change_counter == 10000) {
                    robot_mode = (robot_mode + 1) % 3;
                    node_count = 0;
                    last_node  = -1;
                    stop();
                }
                break;

            // ------------------------------------------------
            case 1: // DIAGNOSTIC DRIVE
            // ------------------------------------------------
                LED_SYS_OK = 0; LED_BUSY = 1; LED_ERROR = 0;
                __delay_ms(500);
                forward();    __delay_ms(2000);
                stop();       __delay_ms(1000);
                soft_left();  __delay_ms(2000);
                stop();       __delay_ms(1000);
                soft_right(); __delay_ms(2000);
                stop();       __delay_ms(1000);
                hard_left();  __delay_ms(2000);
                stop();       __delay_ms(1000);
                hard_right(); __delay_ms(2000);
                stop();       __delay_ms(1000);
                robot_mode = (robot_mode + 1) % 3;
                node_count = 0;
                last_node  = -1;
                stop();
                break;

            // ------------------------------------------------
            case 2: // FULL AUTONOMOUS
            // ------------------------------------------------
                LED_SYS_OK = 0; LED_BUSY = 0; LED_ERROR = 1;

                {
                    uint16_t dist = sonar_read_cm();
                    (void)dist;
                }

                if (detect_junction()) {
                    if (!junction_lock) {
                        junction_count++;
                        junction_lock = 1;
                        stop();
                        __delay_ms(100);
                        demo_placement();
                        forward();
                        __delay_ms(300);
                    }
                } else {
                    junction_lock = 0;
                }

                line_follow();
                break;
        }
    }
}
