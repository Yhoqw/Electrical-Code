module bus(
    input  [7:0] in_PC,
    input  [7:0] in_memory,
    input  [7:0] in_IR,
    input  [7:0] in_ACC,
    input  [7:0] in_ALU,
    input  [2:0] sel,
    output [7:0] data
);
    assign data = (sel == 00) ? in_PC    :
                  (sel == 01) ? in_IR    :
                  (sel == 02) ? in_ACC   :
                  (sel == 03) ? in_ALU   :
                  (sel == 04) ? in_memory:
                                 in_memory;
endmodule

module instruction_decoder(
    input  [2:0] opcode,
    input        clk,
    input        reg_clr,
    output       oclk,
    output       inc_PC,
    output       ld_MAR,
    output       ld_IR,
    output       ld_ACC,
    output       ld_Breg,
    output       ld_out,
    output [2:0] ld_bus,
    output       mem_wr,
    output       cin,
    output       sum,
    output       tx,
    output [2:0] T
);
    wire clr_sc;

    assign clr_sc = (T == 3 | reg_clr) ? 1 : 0;

    sequence_counter sc(
        .sc_out(T),
        .clk(oclk),
        .clr(clr_sc)
    );

    control_block cb(
        .oclk(oclk),
        .inc_PC(inc_PC),
        .ld_MAR(ld_MAR),
        .ld_IR(ld_IR),
        .ld_ACC(ld_ACC),
        .ld_Breg(ld_Breg),
        .ld_out(ld_out),
        .ld_bus(ld_bus),
        .mem_wr(mem_wr),
        .cin(cin),
        .sum(sum),
        .tx(tx),
        .opcode(opcode),
        .T(T),
        .clk(clk),
        .reg_clr(reg_clr)
    );
endmodule


module sequence_counter(
    output [2:0] sc_out,
    input        clk,
    input        clr
);
    reg [2:0] count;
    assign sc_out = count;

    initial count = 0;

    always @(posedge clk) begin
        if (clr)
            count <= 0;
        else
            count <= count + 1;
    end
endmodule


module control_block(
    output       oclk,
    output       inc_PC,
    output       ld_MAR,
    output       ld_IR,
    output       ld_ACC,
    output       ld_Breg,
    output       ld_out,
    output [2:0] ld_bus,
    output       mem_wr,
    output       cin,
    output       sum,
    output       tx,
    input  [2:0] opcode,
    input  [2:0] T,
    input        clk,
    input        reg_clr
);
    reg [12:0] control_vector;
    reg        clk_en;

    assign {inc_PC, ld_MAR, ld_IR, ld_ACC, ld_Breg, ld_out,
            ld_bus, mem_wr, cin, sum, tx} = control_vector;

    assign oclk = clk | (clk_en & ~reg_clr);

    always @(*) begin
        clk_en = 0;
        case (T)
            0: control_vector = 13'b1_10000_000_0_000; // load MAR with PC. Increment PC
            1: control_vector = 13'b0_11000_100_0_000; // load IR with mem[MAR]. Load MAR with address field
            2: control_vector = 13'b0_00010_100_0_000; // load B register with the operand
            3: begin
                case (opcode)
                    0: control_vector = 13'b0_00100_011_0_001; // LDA
                    1: control_vector = 13'b0_00100_011_0_010; // Add
                    2: control_vector = 13'b0_00100_011_0_000; // Sub
                    3: control_vector = 13'b0_00001_011_0_001; // Out
                    4: begin
                        control_vector = 13'b0_00000_000_0_000; // Hlt
                        clk_en = 1;
                    end
                    default: control_vector = 13'bz_zzzzz_zzz_z_zzz;
                endcase
            end
            default: control_vector = 13'bz_zzzzz_zzz_z_zzz;
        endcase
    end
endmodule

`timescale 1ns / 1ps
module ProgramCounter(
    output [3:0] data_out,
    input        en,
    input        clk,
    input        inc,
    input        clr
);
    reg [3:0] data;

    assign data_out = (en) ? data : 8'hzz;

    always @(posedge clk) begin
        if (en) begin
            if (clr)
                data <= 8'h0;
            else if (inc)
                data <= data + 1;
        end
    end
endmodule

module synch_memory( 
    input enable, 
    input we, 
  input clk, 
    input [3:0] address, 
    inout [7:0] data 
    ); 
  reg [7:0] memory[15:0]; 
  reg [7:0] out_reg; 
  initial begin 
  $readmemh("mem_init.mem", memory); 
  end 
  //assign data =(enable && !we) ? out_reg : 8'bzzzzzzzz; 
  assign data =(enable && !we) ? memory[address] : 8'bzzzzzzzz; 
  always @ (posedge clk) begin 
  //out_reg <= memory[address]; 
  if (enable && we)  
   memory[address] <= data; 
  end 
endmodule

module AddressRegister(
    output [3:0] address_out,
    input  [3:0] data_in,
    input        en,
    input        clk,
    input        ld,
    input        clr
);
    reg [3:0] data;

    assign address_out = (en) ? data : 4'hz;

    always @(posedge clk) begin
        if (en) begin
            if (clr)
                data <= 4'h0;
            else if (ld)
                data <= data_in;
        end
    end
endmodule

module adder_subtractor(
    output [7:0] out_to_bus,
    output       cout,
    input  [7:0] A,
    input  [7:0] B,
    input        cin,
    input        sum,
    input        tx,
    input        en
);
    assign {cout, out_to_bus} = (!en) ? 9'hzzz :
                                (tx)  ? B :
                                (sum) ? A + B + cin :
                                        A - B + cin;
endmodule

module GP_reg(
    input  [7:0] data_in,
    input        en,
    input        clk,
    input        ld,
    input        clr,
    output [7:0] data_out
);
    reg [7:0] data;

    assign data_out = (en) ? data : 8'hzz;

    always @(posedge clk) begin
        if (en) begin
            if (clr)
                data <= 8'h00;
            else if (ld)
                data <= data_in;
        end
    end
endmodule

module GP_reg(
    input  [7:0] data_in,
    input        en,
    input        clk,
    input        ld,
    input        clr,
    output [7:0] data_out
);
    reg [7:0] data;

    assign data_out = (en) ? data : 8'hzz;

    always @(posedge clk) begin
        if (en) begin
            if (clr)
                data <= 8'h00;
            else if (ld)
                data <= data_in;
        end
    end
endmodule

module processor(
    input        en,
    input        clk,
    input        reg_clr,
    output [7:0] bus_out,
    output [7:0] output_reg,
    output [7:0] from_Acc,
    output [2:0] SC_cycle
);
    wire        control_clk;
    wire        inc_PC;
    wire        ld_MAR, ld_IR, ld_ACC, ld_Breg, ld_out;
    wire [2:0]  ld_bus;
    wire        mem_wr;
    wire        ALU_cin, ALU_sum, ALU_tx;
    wire [3:0]  from_PC;
    wire [7:0]  from_memory;
    wire [7:0]  from_IR;
    wire [7:0]  from_ALU;

    instruction_decoder decoder_controller(
        .opcode(from_IR[6:4]),
        .clk(clk),
        .reg_clr(reg_clr),
        .oclk(control_clk),
        .inc_PC(inc_PC),
        .ld_MAR(ld_MAR),
        .ld_IR(ld_IR),
        .ld_ACC(ld_ACC),
        .ld_Breg(ld_Breg),
        .ld_out(ld_out),
        .ld_bus(ld_bus),
        .mem_wr(mem_wr),
        .cin(ALU_cin),
        .sum(ALU_sum),
        .tx(ALU_tx),
        .T(SC_cycle)
    );

    bus proc_bus(
        .in_PC({4'h0, from_PC}),
        .in_memory(from_memory),
        .in_IR(from_IR),
        .in_ACC(from_Acc),
        .in_ALU(from_ALU),
        .sel(ld_bus),
        .data(bus_out)
    );

    wire [3:0] address_from_AR;

    synch_memory proc_memory(
        .enable(en),
        .we(mem_wr),
        .clk(control_clk),
        .address(address_from_AR),
        .data(from_memory)
    );

    wire [7:0] from_B;
    wire       cout;

    adder_subtractor proc_ALU(
        .out_to_bus(from_ALU),
        .cout(cout),
        .A(from_Acc),
        .B(from_B),
        .cin(ALU_cin),
        .sum(ALU_sum),
        .tx(ALU_tx),
        .en(en)
    );

    GP_reg ACC(
        .data_in(bus_out),
        .en(en),
        .clk(control_clk),
        .ld(ld_ACC),
        .clr(reg_clr),
        .data_out(from_Acc)
    );

    GP_reg B(
        .data_in(bus_out),
        .en(en),
        .clk(control_clk),
        .ld(ld_Breg),
        .clr(reg_clr),
        .data_out(from_B)
    );

    GP_reg out(
        .data_in(bus_out),
        .en(en),
        .clk(control_clk),
        .ld(ld_out),
        .clr(reg_clr),
        .data_out(output_reg)
    );

    GP_reg IR(
        .data_in(bus_out),
        .en(en),
        .clk(control_clk),
        .ld(ld_IR),
        .clr(reg_clr),
        .data_out(from_IR)
    );

    ProgramCounter PC(
        .en(en),
        .clk(control_clk),
        .inc(inc_PC),
        .clr(reg_clr),
        .data_out(from_PC)
    );

    AddressRegister MAR(
        .data_in(bus_out[3:0]),
        .en(en),
        .clk(control_clk),
        .ld(ld_MAR),
        .clr(reg_clr),
        .address_out(address_from_AR)
    );
endmodule

